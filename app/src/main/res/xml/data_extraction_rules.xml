<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="aura_local.db" />
        <exclude domain="database" path="aura_local.db-shm" />
        <exclude domain="database" path="aura_local.db-wal" />
        <exclude domain="file" path="clothing-images" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="aura_local.db" />
        <exclude domain="file" path="clothing-images" />
    </device-transfer>
</data-extraction-rules>
